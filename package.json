{
  "name": "merge-conflict",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p packages/shared",
    "typecheck:web": "tsc --noEmit -p apps/web",
    "dev:web": "npm run dev -w @merge-conflict/web",
    "build:web": "npm run build -w @merge-conflict/web"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
